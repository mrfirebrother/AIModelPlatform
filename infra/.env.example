﻿POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ai_platform
POSTGRES_USER=ai_platform
POSTGRES_PASSWORD=change-me
# Optional complete URL override. Leave empty to build it from POSTGRES_* fields.
POSTGRES_URL=
REDIS_URL=redis://redis:6379/0

MODEL_DIR=/data/models
DATASET_DIR=/data/datasets
LOG_DIR=/data/logs
CHECKPOINT_DIR=/data/checkpoints
GPU_DEVICE=0
GPU_READY=false
PLATFORM_API_KEY=change-me
WORKER_READY=false
MAX_INFERENCE_INPUT_BYTES=10485760
MAX_INFERENCE_CONCURRENCY=1
GPU_MEMORY_RESERVATION_MB=4096
TRAINING_DEFAULT_EPOCHS=100
TRAINING_DEFAULT_BATCH_SIZE=16

HOST_POSTGRES_DIR=./postgres
HOST_MODELS_DIR=./models
HOST_DATASETS_DIR=./datasets
HOST_LOGS_DIR=./logs
HOST_CHECKPOINTS_DIR=./checkpoints

# --- GPU Configuration ----------------------------------------------------
# Number of GPUs to reserve per service (requires NVIDIA Container Toolkit)
GPU_COUNT=1
# NVIDIA device visibility (all, none, or specific GPU IDs like 0,1)
NVIDIA_VISIBLE_DEVICES=all
# NVIDIA driver capabilities to expose (compute, utility, graphics, video)
NVIDIA_DRIVER_CAPABILITIES=compute,utility
